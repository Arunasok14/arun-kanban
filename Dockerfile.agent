# kanban-agent — Docker sandbox image for running AI coding agents
#
# Build:
#   docker build -f Dockerfile.agent -t kanban-agent:latest .
#
# The container runs as a non-root user (agent) for safety.
# The host worktree is mounted at /workspace at runtime.

FROM node:22-slim

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    python3 \
    python3-pip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Configure git safe directory so the mounted worktree is trusted
RUN git config --global --add safe.directory /workspace

# Install CLI agents globally
RUN npm install -g \
    @anthropic-ai/claude-code \
    @openai/codex \
    @google/gemini-cli

# Create non-root user
RUN useradd -m -s /bin/bash -u 1001 agent

# Set working directory (overridden at runtime to /workspace)
WORKDIR /workspace

# Drop to non-root for agent execution
USER agent

# Default entrypoint — overridden by runtime command
ENTRYPOINT ["/bin/bash", "-c"]
CMD ["echo 'No command specified'"]
